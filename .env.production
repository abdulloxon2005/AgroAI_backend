# ==============================================================================
# AgroAI Production Environment Variables
# ==============================================================================

# Application
APP_NAME="AgroAI"
APP_VERSION="1.0.0"
DEBUG=false

# Authentication (Change JWT_SECRET_KEY to a secure random string on server!)
JWT_SECRET_KEY="production-secret-key-change-this-to-a-secure-random-hash"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:////app/data/agroai.db"

# External API Keys (Insert your valid production keys)
GEMINI_API_KEY="YOUR_PRODUCTION_GEMINI_API_KEY"
OPENWEATHERMAP_API_KEY="YOUR_PRODUCTION_OPENWEATHER_API_KEY"

# Host & Port
HOST="0.0.0.0"
PORT=8000

# File Upload Settings
UPLOAD_DIR="/app/uploads"
MAX_FILE_SIZE=10485760

# Allowed CORS Origins (Replace with your frontend app domain or IP)
ALLOWED_ORIGINS='["http://localhost:3000","https://yourdomain.com","*"]'

# AI Model
GEMINI_MODEL="gemini-2.0-flash"

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_SCAN="20/minute"

# Timeouts
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
WEATHER_CACHE_TTL=600
